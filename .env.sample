# Copy this file to .env and fill in your real values.
# The orchestrator sources this file from bash, so normal shell expansion works.

CLIENT_HOST=192.168.1.101
CLIENT_USER=zonsys
FORGELINE_BRIDGE_ROOT=/home/zonsys/fbws

SERVER_HOST=192.168.1.103
SERVER_USER=zonsys
SERVER_FORGELINE_ROOT=/home/zonsys/fsws
SERVER_PORT=8080

# Optional extra SSH options for the developer machine reaching each host.
# Example: -i /Users/you/.ssh/id_ed25519
SSH_OPTS_SERVER=
SSH_OPTS_CLIENT=

# Optional extra ssh/rsync options that devcheck.sh should use from the client
# machine when it connects to the server machine.
DEVCHECK_SSH_OPTS=

# Optional SSH port overrides. Leave these at 22 unless your hosts use
# non-default SSH ports.
SERVER_SSH_PORT=22
CLIENT_SSH_PORT=22

# Remote staging directories on each machine. These must be absolute paths.
REMOTE_STAGE_DIR_SERVER=/tmp/forgeline-release-stage
REMOTE_STAGE_DIR_CLIENT=/tmp/forgeline-release-stage

# Local release bundle version directory to use from this checkout.
VERSION=latest
VERIFY_CHECKSUMS=1

# Optional behavior switches.
START_SERVER=true
RUN_DEVCHECK=true
BOOTSTRAP_CLIENT_SSH_TO_SERVER=false

# Optional overrides if your real setup differs from the defaults.
DEVCHECK_BRIDGE_ADDR=127.0.0.1:6280
